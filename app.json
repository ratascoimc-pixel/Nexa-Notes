{
  "expo": {
    "name": "Notz",
    "slug": "nexa-notes",
    "scheme": "nexanotes",
    "version": "1.4.0",
    "orientation": "portrait",
    "icon": "./assets/notz-icon.png",
    "userInterfaceStyle": "dark",
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Notz to record audio for transcription and organized notes.",
          "enableBackgroundRecording": true
        }
      ],
      "expo-router"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nexanotes.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.nexanotes.app",
      "permissions": [
        "RECORD_AUDIO",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MICROPHONE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/notz-icon.png",
        "backgroundColor": "#020812"
      }
    }
  }
}
