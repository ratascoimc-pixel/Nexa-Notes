{
  "expo": {
    "name": "NOTZ Preview",
    "slug": "notz-sharing-preview",
    "scheme": "notz-sharing-preview",
    "version": "1.6.0",
    "orientation": "portrait",
    "icon": "./assets/notz-icon.png",
    "userInterfaceStyle": "dark",
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Allow NOTZ to record audio for transcription and organized notes.",
          "enableBackgroundRecording": true
        }
      ],
      "expo-router"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.masterkeyone.notz",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.masterkeyone.notzsharingpreview",
      "versionCode": 8,
      "permissions": [
        "RECORD_AUDIO",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MICROPHONE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/notz-icon-foreground.png",
        "backgroundColor": "#020812"
      }
    }
  }
}
